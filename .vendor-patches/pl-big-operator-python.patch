+def sympy_to_big_operator_json(value: SympyBigOperator) -> BigOperatorJson:
+    """Encode a native one-binder SymPy big operator without serializing tuples.
+
+    ``Sum``, ``Product``, and ``Integral`` values may have one bounds or domain
+    binder. ``Limit`` values are encoded with an approach target and direction.
+    Indefinite integrals, multiple binders, and nested big operators are not
+    representable by the version 1 structured format.
+
+    Args:
+        value: A supported native SymPy big operator.
+
+    Returns:
+        A JSON-serializable, canonical big-operator dictionary.
+
+    Raises:
+        TypeError: If ``value`` is not a supported SymPy big operator or its
+            binder index is not a symbol.
+        ValueError: If the operator shape cannot be represented without a
+            SymPy tuple.
+    """
+    if isinstance(value, sympy.Limit):
+        if len(value.args) != 4:
+            raise ValueError("SymPy Limit must contain one target and direction.")
+        body, index, target, raw_direction = value.args
+        direction = _DIRECTION_NAMES.get(str(raw_direction))
+        if direction is None:
+            raise ValueError("SymPy Limit has an unsupported direction.")
+        return big_operator_to_json(
+            operator="Limit",
+            indexing="approaches",
+            index=index,  # type: ignore[arg-type]
+            target=target,  # type: ignore[arg-type]
+            direction=direction,
+            body=body,  # type: ignore[arg-type]
+        )
+
+    operator: Literal["Sum", "Product", "Integral"]
+    if isinstance(value, sympy.Sum):
+        operator = "Sum"
+    elif isinstance(value, sympy.Product):
+        operator = "Product"
+    elif isinstance(value, sympy.Integral):
+        operator = "Integral"
+    else:
+        raise TypeError(
+            "Expected a SymPy Sum, Product, Integral, or Limit big operator."
+        )
+
+    if len(value.limits) != 1:
+        raise ValueError(f"SymPy {operator} must contain exactly one binder.")
+    binder = value.limits[0]
+    match len(binder):
+        case 1:
+            raise ValueError(
+                f"Indefinite SymPy {operator} values are not supported by big-operator serialization."
+            )
+        case 2:
+            index, domain = binder
+            return big_operator_to_json(
+                operator=operator,
+                indexing="domain",
+                index=index,  # type: ignore[arg-type]
+                domain=domain,  # type: ignore[arg-type]
+                body=value.function,  # type: ignore[arg-type]
+            )
+        case 3:
+            index, lower, upper = binder
+            return big_operator_to_json(
+                operator=operator,
+                indexing="bounds",
+                index=index,  # type: ignore[arg-type]
+                lower=lower,  # type: ignore[arg-type]
+                upper=upper,  # type: ignore[arg-type]
+                body=value.function,  # type: ignore[arg-type]
+            )
+        case _:
+            raise ValueError(f"SymPy {operator} has an unsupported binder shape.")
+
+
